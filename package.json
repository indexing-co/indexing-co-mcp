{
  "name": "indexing-co-mcp",
  "version": "1.0.0",
  "description": "MCP server for streaming live blockchain data from Indexing Co pipelines",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:compile && npm run install-skill",
    "build:compile": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:compile && node scripts/hardening-check.mjs",
    "install-skill": "node scripts/install-skill.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "preview": "node dist/cli/preview.js",
    "dashboard": "node dist/cli/dashboard.js",
    "quality:contract": "node --test scripts/quality-contract.test.mjs",
    "quality:baseline": "npm run quality:contract && npm run typecheck && npm test",
    "quality:security": "node scripts/hardening-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
